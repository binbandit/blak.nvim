---
const stack = [
  { role: "Package manager", tool: "lazy.nvim", note: "rollback snapshots included" },
  { role: "Default picker", tool: "fff.nvim", note: "Rust-backed file search" },
  { role: "Completion", tool: "blink.cmp", note: null },
  { role: "LSP wiring", tool: "vim.lsp.config()", note: "native, no wrapper" },
  { role: "Formatter", tool: "conform.nvim", note: null },
  { role: "Linter", tool: "nvim-lint", note: null },
  { role: "Treesitter", tool: "nvim-treesitter", note: null },
  { role: "Explorer", tool: "oil.nvim", note: "neo-tree / snacks via extras" },
  { role: "Git signs", tool: "gitsigns.nvim", note: null },
  { role: "Keymap hints", tool: "which-key.nvim", note: "discoverable Blak shortcuts" },
  { role: "Dashboard", tool: "Snacks", note: "black-hole splash" },
  { role: "Colorscheme", tool: "TokyoNight Night", note: "tokyonight-night" },
];
---

<section class="section">
  <header class="section-head">
    <span class="eyebrow">
      <span class="eyebrow-dot" aria-hidden="true"></span>
      <span>// stack</span>
    </span>
    <h2 class="section-title">The default kit.</h2>
    <p class="section-sub">
      The main tools in the default kit. Language stacks and additional workflows
      are available as opt-in extras.
    </p>
  </header>

  <div class="kit-wrap">
    <ul class="kit" aria-label="Default tools shipped with Blak">
      {stack.map((row) => (
        <li class="kit-cell">
          <span class="kit-cell-role">{row.role}</span>
          <p class="kit-cell-tool" translate="no">{row.tool}</p>
          {row.note && <p class="kit-cell-note">{row.note}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
